# ─── Application ────────────────────────────────────────────────────────────────
APP_ENV=development
SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ─── Database ────────────────────────────────────────────────────────────────────
# SQLite (default local dev)
DATABASE_URL=sqlite:///./medlens.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/medlens

# ─── AI Provider ─────────────────────────────────────────────────────────────────
# Set to "mock" to use the built-in demo AI (no API key required)
# Set to "openai" to use OpenAI (requires OPENAI_API_KEY)
# Set to "openai_compatible" for any OpenAI-compatible endpoint
AI_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Document Processing ─────────────────────────────────────────────────────────
# Path to tesseract executable (for OCR on scanned PDFs / images)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=tesseract

# ─── File Upload ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=20

# ─── CORS ────────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
